Content-Type: application/json

{
  "company": "Google",
  "role": "Software Engineering Intern",
  "location": "London",
  "jobLink": "https://careers.google.com",
  "dateApplied": "2026-10-01",
  "deadline": "2026-10-08",
  "status": "Applied",
  "notes": "Referred by a friend"
}

